#!/usr/bin/python3

"""Run one reviewed QR65 consumer command with bounded process ownership."""

from __future__ import annotations

import ctypes
import os
import re
import selectors
import signal
import subprocess
import sys
import time
from pathlib import Path

TIMEOUT_SECONDS = 15
KILL_GRACE_SECONDS = 2
STREAM_LIMIT = 16_384
COLOR = re.compile(r"#[0-9A-Fa-f]{6}\Z")
cancelled = False


def valid_command(args: list[str]) -> bool:
    """Return whether args name one Consumer API operation used by the plugin."""
    if args in (["api-version", "--json"], ["status", "--json"], ["sync"],
                ["release"], ["resume"]):
        return True
    if len(args) == 3 and args[:2] in (["mode", "dynamic"], ["mode", "static"]):
        return COLOR.fullmatch(args[2]) is not None
    if len(args) == 2 and args[0] == "brightness":
        return args[1].isdigit() and 0 <= int(args[1]) <= 100
    return len(args) == 2 and args[0] == "color-matching" and args[1] in ("on", "off")


def set_parent_death_signal(parent_pid: int, death_signal: int) -> None:
    """Signal this process if its expected parent disappears."""
    if parent_pid <= 1:
        raise RuntimeError("refusing to run without the expected parent")
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(1, death_signal) != 0:
        raise OSError(ctypes.get_errno(), "prctl(PR_SET_PDEATHSIG) failed")
    if os.getppid() != parent_pid:
        os.kill(os.getpid(), signal.SIGKILL)


def request_stop(_signum: int, _frame: object) -> None:
    """Defer process-group cleanup to the normal supervision loop."""
    global cancelled
    cancelled = True


def group_exists(group_id: int) -> bool:
    """Return whether any process remains in group_id."""
    try:
        os.killpg(group_id, 0)
        return True
    except ProcessLookupError:
        return False


def stop_group(process: subprocess.Popen[bytes]) -> None:
    """Terminate and then kill the complete daemon-command process group."""
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        process.poll()
        return
    deadline = time.monotonic() + KILL_GRACE_SECONDS
    while group_exists(process.pid) and time.monotonic() < deadline:
        time.sleep(0.02)
    if group_exists(process.pid):
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass


def supervise(args: list[str]) -> int:
    """Execute one daemon command with output, time, and process-tree limits."""
    home = os.environ.get("HOME", "")
    if not home:
        print("QR65 supervisor requires HOME.", file=sys.stderr)
        return 126
    executable = Path(home) / ".local/bin/edifier-qr65"
    if not executable.is_file() or not os.access(executable, os.X_OK):
        print("Edifier QR65 daemon is not installed or unavailable.", file=sys.stderr)
        return 127

    parent_pid = os.getpid()
    process = subprocess.Popen(
        [str(executable), *args],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
        preexec_fn=lambda: set_parent_death_signal(parent_pid, signal.SIGKILL),
    )
    assert process.stdout is not None and process.stderr is not None
    selector = selectors.DefaultSelector()
    streams = {process.stdout: bytearray(), process.stderr: bytearray()}
    selector.register(process.stdout, selectors.EVENT_READ)
    selector.register(process.stderr, selectors.EVENT_READ)
    deadline = time.monotonic() + TIMEOUT_SECONDS
    result = 0

    try:
        while process.poll() is None or selector.get_map():
            if cancelled:
                result = 143
                break
            if time.monotonic() >= deadline:
                result = 124
                break
            if not selector.get_map():
                time.sleep(0.02)
                continue
            for key, _events in selector.select(0.1):
                chunk = os.read(key.fileobj.fileno(), 4096)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                output = streams[key.fileobj]
                output.extend(chunk)
                if len(output) > STREAM_LIMIT:
                    result = 125
                    break
            if result:
                break
        if not result:
            result = process.returncode
    finally:
        selector.close()
        stop_group(process)

    if result == 124:
        streams[process.stderr] = bytearray(b"QR65 command timed out.\n")
    elif result == 125:
        streams[process.stderr] = bytearray(b"QR65 command produced too much output.\n")
    os.write(sys.stdout.fileno(), streams[process.stdout][:STREAM_LIMIT])
    os.write(sys.stderr.fileno(), streams[process.stderr][:STREAM_LIMIT])
    return result


def run_guardian(args: list[str]) -> int:
    """Proxy one command through a guardian that survives long enough to clean up."""
    parent_pid = os.getpid()
    guardian = subprocess.Popen(
        [str(Path(__file__).resolve()), "--guardian", *args],
        stdin=subprocess.DEVNULL,
        preexec_fn=lambda: set_parent_death_signal(parent_pid, signal.SIGTERM),
    )
    try:
        while guardian.poll() is None:
            if cancelled:
                guardian.terminate()
                break
            time.sleep(0.02)
        try:
            return guardian.wait(timeout=TIMEOUT_SECONDS + KILL_GRACE_SECONDS + 2)
        except subprocess.TimeoutExpired:
            guardian.kill()
            guardian.wait()
            return 124
    finally:
        if guardian.poll() is None:
            guardian.terminate()
            try:
                guardian.wait(timeout=KILL_GRACE_SECONDS + 1)
            except subprocess.TimeoutExpired:
                guardian.kill()
                guardian.wait()


def main() -> int:
    """Validate and supervise the requested Consumer API operation."""
    args = sys.argv[1:]
    guardian_mode = bool(args and args[0] == "--guardian")
    if guardian_mode:
        args = args[1:]
    if not valid_command(args):
        print("Unsupported QR65 consumer command.", file=sys.stderr)
        return 2
    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    set_parent_death_signal(os.getppid(), signal.SIGTERM)
    return supervise(args) if guardian_mode else run_guardian(args)


if __name__ == "__main__":
    raise SystemExit(main())
